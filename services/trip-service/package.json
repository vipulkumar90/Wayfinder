{
  "name": "trip-service",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "dev:debug": "tsx --inspect watch src/app.ts",
    "grpc": "tsx watch src/grpcServer.ts",
    "build": "tsc && tsc-alias",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "start": "node dist/app.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "proto:gen": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/grpc/__generated__ --ts_proto_opt=esModuleInterop=true,outputServices=grpc-js,env=node,useOptionals=messages,importSuffix=.js --proto_path=../../shared/protos ../../shared/protos/*.proto"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "@jest/globals": "^30.1.2",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "jest": "^30.1.3",
    "prisma": "^6.16.2",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.7.7",
    "tsc-alias": "^1.8.16",
    "tsx": "^3.12.7",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "@prisma/client": "^6.16.2",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "winston": "^3.17.0",
    "zod": "^4.1.9",
    "@bufbuild/protobuf": "^2.9.0"
  }
}
