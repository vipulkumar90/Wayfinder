// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip {
  id          String    @id @default(cuid())
  userId      String
  title       String?
  destination String
  startDate   DateTime
  endDate     DateTime?
  budget      Float
  currency    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
